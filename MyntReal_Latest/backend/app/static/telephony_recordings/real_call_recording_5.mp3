<script>
    $(function() {

        function toggleLoginHiglights(cond) {

            let login_highlight_image_url = "https://cdn.myoperator.com/dashboard/myoperator-panel-login-bg.png";
            if (cond.matches) {
                login_highlight_image_url = "https://cdn.myoperator.com/dashboard/mobilelogin-dashboardbg.png";
            }
            let login_highlight_redirect_url = "https://support.myoperator.co/portal/kb/articles/what-are-follow-ups-how-to-make-best-use-of-it";

            let is_special_login_highlight_shown = localStorage.getItem("is_special_login_highlight_shown");
            if (is_special_login_highlight_shown == null || is_special_login_highlight_shown == false) {
                login_highlight_image_url = "https://cdn.myoperator.com/dashboard/myoperator-panel-login-bg.png";
                if (cond.matches) {
                    login_highlight_image_url = "https://cdn.myoperator.com/dashboard/mobilelogin-dashboardbg.png";
                }
                login_highlight_redirect_url = "javascript:void(0)";
            }

            $('#login-highlight-image-container').css('background', `url(${login_highlight_image_url}) no-repeat center top / cover`);
            $('#login-highlight-image-container-parent').attr("href", login_highlight_redirect_url);
            if (login_highlight_redirect_url == "javascript:void(0)") {
                $('#login-highlight-image-container-parent').removeAttr('target');
            }

        }

        var cond = window.matchMedia("(max-width: 1025px)");
        toggleLoginHiglights(cond);
        cond.addListener(toggleLoginHiglights);

    });
</script>

<form id="login_master" class="pull-left" method="post" data-parsley-namespace="data-parsley-" data-parsley-validate novalidate autocomplete="off" action="/users/login" onSubmit="return validate_login_master(this)" style="margin: 0;">
    <div class="full-width pull-left">

        <div class="full-width pull-left m-b-30">
            <label class="login-label">Username</label>
            <div class="pull-left full-width m-t-5">
                <input id="phone" name="data[User][username]" type="tel" class="login-input">
                <input name="webmenu" type="hidden" value="">
            </div>
        </div>

        <div class="full-width pull-left m-b-30">
            <label class="login-label">Password</label>
            <input id="password" type="password" required class="login-input validate[required]" name="data[User][password]" placeholder="xxxxxx">
        </div>

        <div class="full-width pull-left m-b-30 text-center remember-div">
            <input type="checkbox" required class="validate[required] logincheck" name="data[User][remember_me]" value="1" id="logincheck">
            <label for="logincheck" class="login-remember">Remember me</label>
        </div>

        <input type="hidden" id="grecaptcha_token" value="" name="data[User][grecaptcha_token]">
        <input type="hidden" id="grecaptcha_token_ts" value="" name="data[User][grecaptcha_token_ts]">

        <div class="full-width pull-left m-b-30">
            <button type="submit" class="login-button-new" disabled>
                LOGIN
            </button>
        </div>
        <div class="full-width pull-left text-center">
            <a href="https://signup.myoperator.com" id="create_account" class="login-forgot pull-left">Create an account? </a>
            <a href="/forgot-password" class="login-forgot forgot_password pull-right">Forgot password?</a>
        </div>
    </div>
</form>


<script type="text/javascript">
    var countries_shortcodes = JSON.parse('["nz","in","id","it","jp","kr","my","np","nl","at","no","ph","sg","za","lk","se","ae","gb","hu","au","bd","be","br","us","cn","co","hr","cy","cz","dk","ee","fr","de","gl","hk","is"]');

    var loginIntelInpt = null
    var redirect_url = 'https://myoperator.typeform.com/to/hjmyxSzK';
    var outgoing_cookie_value = '';


    $(document).ready(function(e) {

        var loginTimeOut = outgoing_cookie_value && setTimeout(() => {
            window.location = redirect_url;
        }, 5000);

        function stopInactivityRedirecting() {
            console.log("track activity");
            clearTimeout(loginTimeOut);
        }
        $(document).on('click', () => {
            if (loginTimeOut) {
                stopInactivityRedirecting();
            }
        });

        if (is_ios_app === 1 || window.ReactNativeWebView) {
            $('#create_account').hide();
            $('.logincheck').prop('checked', true);
            $('.remember-div').hide();
            $('.forgot_password').removeClass('pull-right');
        }

        // We are enabling remamber me checkbox for all devices web and androd mobile 
        $('.logincheck').prop('checked', true);

        $.get("https://in.app.myoperator.com/GetIp/", function(data) {
            var dt = data;
            var country = dt.country;
            if (country == "") {
                your_country_code = "IN";
            } else {
                your_country_code = country.toUpperCase();
            }
            $("#e4").select2("val", your_country_code);
        }, 'json');

        var input = document.querySelector("#phone");
        loginIntelInpt = window.intlTelInput(input, {
            initialCountry: "in",
            onlyCountries: countries_shortcodes,
            preferredCountries: false,
            separateDialCode: true,
            utilsScript: "https://in.app.myoperator.com/countrycodebuild/js/utils.js",
            customPlaceholder: function(selectedCountryPlaceholder, selectedCountryData) {
                return "Phone number";
            },
            formatOnDisplay: false
        });

        input.addEventListener("countrychange", function() {
            $('input[name=webmenu]').val($('div.iti__selected-dial-code').text());
        });

        $('input[name=webmenu]').val($('div.iti__selected-dial-code').text());

        // Starts disabled in HTML so a login.js failure fails closed; enable it only once page
        // init has actually run.
        $('form#login_master button[type="submit"]').prop("disabled", false);
    });

    function format(state) {
        if (!state.id)
            return state.text; // optgroup
        return "<img style='width: 19px; float: left; margin-top: 6px;' class='flag' src='https://in.app.myoperator.com/img/flags/" + state.id + ".png'/>" + state.text;
    }

    function format1(state) {
        if (!state.id)
            return state.text; // optgroup
        return state.text;
    }

    $("#e4").select2({
        formatResult: format1,
        formatSelection: format,
        escapeMarkup: function(m) {
            return m;
        }
    });

    // A bfcache restore would otherwise leave the form disabled with a stale token, and any
    // watchdog armed before navigating away still counting down toward a spurious toast.
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            cancelPendingCaptchaWatchdogs();
            $('form#login_master button[type="submit"]').prop("disabled", false);
            $('form#login_master input[id="grecaptcha_token"]').val('');
            $('form#login_master input[id="grecaptcha_token_ts"]').val('');
        }
    });
</script>                </div>
            </div>
        </div>
    </div>
